# Template only — NEVER put a real key in this file. It is committed to the repo.
# Copy to .streamlit/secrets.toml (gitignored) and fill in the real values there.
# On Streamlit Community Cloud, set these in the app's Secrets panel instead.

# Active provider: "gemini" (default) or "anthropic"
LLM_PROVIDER = "gemini"

# Required for the active provider only.
GEMINI_API_KEY = "PASTE_YOUR_GEMINI_KEY_HERE"
# ANTHROPIC_API_KEY = "PASTE_YOUR_ANTHROPIC_KEY_HERE"

# Optional overrides.
GEMINI_MODEL = "gemini-3.5-flash-lite"
# Requests per minute the provider will accept. 15 is the Gemini free-tier
# limit. Raise this to your tier's published limit after enabling billing -
# it is the single lever that controls run time. Read the exact figure from
# AI Studio; the client throttles to whatever is set here.
LLM_RPM = "15"

# Upper bound on worker threads. Left unset, the pool is sized to what LLM_RPM
# can actually absorb (at 15 rpm that is one worker).
# LLM_MAX_WORKERS = "8"
