# Template only — NEVER put a real key in this file. It is committed to the repo.
# Copy to .streamlit/secrets.toml (gitignored) and fill in the real values there.
# On Streamlit Community Cloud, set these in the app's Secrets panel instead.

# Active provider: "gemini" (default) or "anthropic"
LLM_PROVIDER = "gemini"

# Required for the active provider only.
GEMINI_API_KEY = "PASTE_YOUR_GEMINI_KEY_HERE"
# ANTHROPIC_API_KEY = "PASTE_YOUR_ANTHROPIC_KEY_HERE"

# Optional overrides.
GEMINI_MODEL = "gemini-3.5-flash-lite"
# Requests per minute the client will issue. This is the single lever that
# controls run time: the worker pool is sized from it, so lowering it lowers
# concurrency as well as pacing.
#
#   15   Gemini free-tier limit, and the built-in default when this is unset.
#   240  a Tier 1 setting - 6% of that tier's 4,000 RPM, ~4 calls/second.
#
# Read your own figure from AI Studio. Raising this above what the pool can
# absorb has no effect: see LLM_MAX_WORKERS below.
LLM_RPM = "240"

# Upper bound on worker threads. Leave unset - the pool is sized to what LLM_RPM
# can absorb (at 240 rpm that is 17 workers, under the built-in cap of 20).
# Set it only to pin a lower ceiling; a higher one cannot beat the rate limit.
# LLM_MAX_WORKERS = "20"
